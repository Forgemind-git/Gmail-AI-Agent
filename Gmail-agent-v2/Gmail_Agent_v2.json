    {
      "parameters": {
        "jsCode": "// Function to strip HTML tags\nconst stripHtml = (str) => str.replace(/<[^>]*>/g, '');\n\n// Function to clean Markdown, line breaks, extra spaces\nconst cleanText = (str) => {\n  return str\n    .replace(/!\\[.*?\\]\\(.*?\\)/g, '')      // Markdown images\n    .replace(/\\[.*?\\]\\(.*?\\)/g, '')       // Markdown links\n    .replace(/[#_*`~>-]+/g, '')           // Other Markdown\n    .replace(/\\\\n|\\\\r|\\\\t|\\n|\\r|\\t/g, ' ') // Escaped + real newlines/tabs\n    .replace(/\\s\\s+/g, ' ')               // Collapse multiple spaces\n    .trim();\n};\n\n// Clean recursively if needed\nconst cleanFormatting = (value) => {\n  if (typeof value === 'string') {\n    return cleanText(stripHtml(value));\n  } else if (Array.isArray(value)) {\n    return value.map(cleanFormatting);\n  } else if (value && typeof value === 'object') {\n    const cleaned = {};\n    for (const key in value) {\n      cleaned[key] = cleanFormatting(value[key]);\n    }\n    return cleaned;\n  }\n  return value;\n};\n\n// Get original data\nconst input = items[0].json;\n\n// Clean the response.text field\nif (input.response && input.response.text) {\n  input.response.text = cleanFormatting(input.response.text);\n}\n\n// Return cleaned item\nreturn [{ json: input }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
